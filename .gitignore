# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# private documents
AGREEMENT.md

# personal React learning (not part of the app)
LEARNING_PATH.md
/learning

# public assets (managed/served separately; new files not tracked)
# NB: ~92 pre-existing files under /public (incl. the valle_chibi_* pngs that
# next/image statically imports) were tracked before this rule existed and STAY
# tracked — gitignore never affects tracked files. Keep it that way: statically
# imported assets must be in the repo or a cold-checkout tsc/build breaks.
/public

# lavish review artifacts
.lavish/

# generated email previews (scripts/test/preview_emails.ts output)
.email-previews/

# generated quest covers (review output; the artwork of record lives in S3)
scripts/covers/out/
